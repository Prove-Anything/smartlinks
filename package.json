{
  "name": "@proveanything/smartlinks",
  "version": "2.0.22",
  "description": "Official JavaScript/TypeScript SDK for the Smartlinks API",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./baseline.css": "./dist/baseline.css",
    "./baseline.classes.json": "./dist/baseline.classes.json",
    "./theme.css": "./dist/theme.css",
    "./theme-boot.js": "./dist/theme-boot.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "smartlinks-register-release": "scripts/register-release.mjs",
    "smartlinks-publish": "scripts/publish.mjs",
    "smartlinks-doctor": "scripts/doctor.mjs"
  },
  "files": [
    "dist/",
    "docs/",
    "scripts/register-release.mjs",
    "scripts/publish.mjs",
    "scripts/doctor.mjs",
    "scripts/lib/",
    "openapi.yaml",
    "README.md"
  ],
  "scripts": {
    "test": "node test/run.cjs",
    "build": "tsc && node scripts/fix-esm-extensions.mjs && node generate-api-summary.cjs && node generate-openapi.cjs && node scripts/copy-docs-to-dist.cjs && node scripts/build-baseline.mjs",
    "docs": "typedoc",
    "docs:summary": "node generate-api-summary.cjs",
    "docs:openapi": "node generate-openapi.cjs",
    "docs:openapi:lint": "npx --yes @redocly/cli@latest lint openapi.yaml",
    "docs:openapi:check": "node generate-openapi.cjs && npx --yes @redocly/cli@latest lint openapi.yaml",
    "build:docs": "tsc build-docs.ts --outDir dist && node dist/build-docs.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "smartlinks",
    "api",
    "authentication",
    "traceability",
    "blockchain",
    "typescript",
    "sdk"
  ],
  "author": "Glenn Shoosmith",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "dependencies": {
    "cross-fetch": "^3.1.5",
    "es-module-lexer": "^1.7.0"
  },
  "devDependencies": {
    "ts-node": "^10.9.1",
    "typedoc": "^0.25.13",
    "typedoc-plugin-markdown": "^3.17.1",
    "typescript": "^4.9.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Prove-Anything/smartlinks.git"
  },
  "homepage": "https://smartlinks.app"
}
